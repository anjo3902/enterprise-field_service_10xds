# Project Environment Variables Template

# Frontend API Configuration
# Copy this to frontend/.env and configure
VITE_API_URL=http://localhost:8000

# Mobile GPS Bridge
# Set this to your laptop's LAN IP so the QR code points to the right address.
# Example: http://192.168.1.10:8000
MOBILE_GPS_PUBLIC_BASE_URL=

# Google Maps API Key (optional)
# Used for reverse geocoding (lat/lng → address).
# If not set, the system falls back to free Nominatim / OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# Python/Backend Configuration
# Infrastructure-managed GCP settings (optional overrides)
# If omitted, project_id is read from service-account.json
GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GCP_LOCATION=us-central1

# Vertex AI (AI diagnosis)
VERTEX_PROJECT_ID=
VERTEX_MODEL_NAME=gemini-2.5-flash

# Firestore (dispatch storage)
# Use FIRESTORE_DATABASE_ID when infra created a named database.
# For this deployment set the database id to the project value (example):
# field-service-dispatcher
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=field-service-dispatcher

# Evidence image storage (GCS)
# In production/Render, set this to the provisioned bucket name.
GCS_BUCKET_NAME=

# Store uploads under a single prefix to simplify lifecycle/cost controls.
GCS_UPLOAD_PREFIX=service_requests

# Signed URL validity in seconds for secure image access.
GCS_SIGNED_URL_TTL_SECONDS=600

# Maximum upload size in bytes (default 2MB).
MAX_EVIDENCE_IMAGE_BYTES=2097152
