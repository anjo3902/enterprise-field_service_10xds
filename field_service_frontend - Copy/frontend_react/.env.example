# ─── API Configuration ──────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8000

# ─── GPS Configuration ──────────────────────────────────────────────
VITE_GPS_DIRECT_MODE=true

# ─── Google Maps API Keys ───────────────────────────────────────────
# SECURITY: These keys are embedded in the client bundle.
# You MUST configure the following restrictions in Google Cloud Console:
#
#   1. HTTP Referrer restriction:
#      - yourdomain.com/*
#      - localhost:3000/*
#   2. API restriction:
#      - Maps JavaScript API
#      - Places API (if used)
#   3. Set daily quota limits and billing alerts
#
# See: https://developers.google.com/maps/api-security-best-practices
#
VITE_GOOGLE_MAPS_API_KEY=your_key_here
# IMPORTANT: must be restricted in GCP
VITE_GOOGLE_MAPS_EMBED_API_KEY=your-embed-api-key-here

# ─── Error Monitoring (Sentry) ──────────────────────────────────────
# Optional. When set, frontend errors are reported to Sentry in production.
# Get your DSN from: https://sentry.io → Project Settings → Client Keys
# Leave empty for local development (monitoring is disabled automatically).
VITE_SENTRY_DSN=
